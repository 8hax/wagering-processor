DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=wagering
DB_USER=wagering
DB_PASSWORD=wagering

# SQS (MiniStack local; credenciais fictícias aceitas pelo emulador)
SQS_ENDPOINT=http://127.0.0.1:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
EVENTS_QUEUE_NAME=wagering-events.fifo

# Publicador da outbox (worker em segundo plano)
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000

# Consumidor da fila de transações (mesmo use case da API HTTP)
WAGER_CONSUMER_ENABLED=true
WAGER_QUEUE_NAME=wager-transactions.fifo
WAGER_DLQ_NAME=wager-transactions-dlq.fifo
WAGER_MAX_RECEIVE_COUNT=5
WAGER_RETRY_BASE_SECONDS=2
WAGER_WAIT_TIME_SECONDS=5

# REFUND/ROLLBACK que chegam antes da transação referenciada (PENDING_REFERENCE)
PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_BASE_DELAY_MS=2000
PENDING_REFERENCE_MAX_DELAY_MS=300000
